{
  "schema_version": 1,
  "graph_id": "ssp-outreach-two-gate",
  "description": "Static outer graph with bounded parallel research and exactly two planned human gates.",
  "nodes": [
    {"id": "run_request", "kind": "input", "depends_on": [], "output": "run-request.schema.json"},
    {"id": "preserve_source", "kind": "deterministic", "depends_on": ["run_request"], "output": "campaign.schema.json"},
    {"id": "normalize_source", "kind": "deterministic", "depends_on": ["preserve_source"], "output": "candidate.schema.json"},
    {"id": "provider_profile", "kind": "agent", "agent": "provider_profiler", "depends_on": ["run_request"], "output": "provider-profile.schema.json"},
    {"id": "traffic_filter", "kind": "deterministic", "depends_on": ["normalize_source"], "output": "candidate.schema.json"},
    {"id": "vertical_classification", "kind": "pipeline", "agent": "publisher_researcher", "depends_on": ["traffic_filter"], "output": "classification.schema.json"},
    {"id": "negative_audit", "kind": "agent", "agent": "evidence_verifier", "depends_on": ["vertical_classification"], "output": "verification.schema.json"},
    {"id": "ownership_seed", "kind": "deterministic", "depends_on": ["vertical_classification"], "output": "account.schema.json"},
    {"id": "ownership_verify", "kind": "pipeline", "agent": "ownership_resolver", "depends_on": ["ownership_seed"], "output": "account.schema.json"},
    {"id": "canonicalize_accounts", "kind": "barrier", "depends_on": ["negative_audit", "ownership_verify"], "output": "account.schema.json"},
    {"id": "resolve_publisher_brand", "kind": "deterministic_with_exceptions", "depends_on": ["canonicalize_accounts"], "output": "account.schema.json"},
    {"id": "known_suppression", "kind": "deterministic", "depends_on": ["resolve_publisher_brand"], "output": "account.schema.json"},
    {"id": "select_smoke", "kind": "deterministic", "depends_on": ["known_suppression", "provider_profile"], "output": "account.schema.json"},
    {"id": "smoke_research", "kind": "pipeline", "agent": "publisher_researcher", "depends_on": ["select_smoke"], "output": "research.schema.json"},
    {"id": "smoke_verify", "kind": "conditional_verification", "agent": "evidence_verifier", "depends_on": ["smoke_research"], "output": "verification.schema.json"},
    {"id": "smoke_copy", "kind": "deterministic_with_exceptions", "depends_on": ["smoke_verify"], "output": "outreach.schema.json"},
    {"id": "smoke_validate", "kind": "deterministic", "depends_on": ["smoke_copy"], "output": "validation.schema.json"},
    {"id": "smoke_review", "kind": "human_gate", "depends_on": ["smoke_validate"], "human_gate": true, "output": "feedback.schema.json"},
    {"id": "freeze_campaign_rules", "kind": "deterministic", "depends_on": ["smoke_review"], "output": "campaign.schema.json"},
    {"id": "full_research", "kind": "pipeline", "agent": "publisher_researcher", "depends_on": ["freeze_campaign_rules", "known_suppression"], "output": "research.schema.json"},
    {"id": "full_verify", "kind": "conditional_verification", "agent": "evidence_verifier", "depends_on": ["full_research"], "output": "verification.schema.json"},
    {"id": "full_copy", "kind": "deterministic_with_exceptions", "depends_on": ["full_verify"], "output": "outreach.schema.json"},
    {"id": "gmail_history_preflight", "kind": "connector_read", "depends_on": ["full_copy"], "output": "suppression.schema.json"},
    {"id": "full_validate", "kind": "deterministic", "depends_on": ["gmail_history_preflight"], "output": "validation.schema.json"},
    {"id": "full_review", "kind": "human_gate", "depends_on": ["full_validate"], "human_gate": true, "output": "feedback.schema.json"},
    {"id": "apply_full_decisions", "kind": "deterministic", "depends_on": ["full_review"], "output": "approval.schema.json"},
    {"id": "gmail_draft_drift_check", "kind": "connector_read", "depends_on": ["apply_full_decisions"], "output": "suppression.schema.json"},
    {"id": "create_gmail_drafts", "kind": "connector_write", "depends_on": ["gmail_draft_drift_check"], "requires_explicit_item_action": true, "output": "action-result.schema.json"},
    {"id": "queue_manual_actions", "kind": "deterministic", "depends_on": ["apply_full_decisions"], "output": "manual-action.schema.json"},
    {"id": "reconcile_actions", "kind": "barrier", "depends_on": ["create_gmail_drafts", "queue_manual_actions"], "output": "campaign.schema.json"},
    {"id": "outreach_complete", "kind": "terminal", "depends_on": ["reconcile_actions"], "output": "campaign.schema.json"}
  ]
}
