{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review decision event",
  "type": "object",
  "required": ["approval_id", "campaign_id", "review_stage", "account_id", "decision", "authorized_action", "recorded_at"],
  "properties": {
    "approval_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "review_stage": {"type": "string", "enum": ["smoke", "full"]},
    "account_id": {"type": "string"},
    "decision": {"type": "string", "enum": ["approved", "needs_changes", "hold", "excluded"]},
    "authorized_action": {"type": "string", "enum": ["create_gmail_draft", "queue_manual_route", "none"]},
    "comment": {"type": "string"},
    "review_id": {"type": "string"},
    "recorded_at": {"type": "string"}
  },
  "additionalProperties": false
}

