{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "campaign_name", "goal", "desired_outcome", "offer", "account_definition", "team_profile", "channels", "targeting_rules", "confirmed"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_name": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "desired_outcome": {"type": "string", "minLength": 1},
    "offer": {"type": "string", "minLength": 1},
    "account_definition": {"type": "string", "minLength": 1},
    "team_profile": {"$ref": "team-profile.schema.json"},
    "save_team_profile": {"type": "boolean"},
    "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["gmail", "outlook", "manual_export"]}},
    "targeting_rules": {"type": "array", "items": {"$ref": "targeting-rule.schema.json"}},
    "accepted_recommendations": {"type": "array"},
    "unresolved_items": {"type": "array"},
    "confirmed": {"const": true}
  }
}
