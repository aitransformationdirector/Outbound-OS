{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign state",
  "type": "object",
  "required": ["schema_version", "campaign_id", "target_provider", "stage", "source", "review_gates", "external_actions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "target_provider": {"type": "string", "minLength": 1},
    "user_note": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "stage": {
      "type": "string",
      "enum": [
        "source_audited",
        "provider_profile_ready",
        "candidates_classified",
        "accounts_consolidated",
        "waiting_smoke_review",
        "smoke_approved",
        "waiting_full_review",
        "full_review_approved",
        "actions_complete",
        "blocked"
      ]
    },
    "source": {"type": "object"},
    "defaults_snapshot": {"type": "object"},
    "review_gates": {
      "type": "object",
      "required": ["smoke_review", "full_review"],
      "properties": {
        "smoke_review": {"type": "string", "enum": ["not_ready", "waiting", "changes_requested", "approved"]},
        "full_review": {"type": "string", "enum": ["not_ready", "waiting", "changes_requested", "approved"]}
      },
      "additionalProperties": false
    },
    "external_actions": {
      "type": "object",
      "required": ["gmail_drafts", "send_email", "submit_forms"],
      "properties": {
        "gmail_drafts": {"type": "string", "enum": ["not_authorized", "item_review_required", "partially_complete", "complete"]},
        "send_email": {"type": "boolean", "const": false},
        "submit_forms": {"type": "boolean", "const": false}
      },
      "additionalProperties": false
    },
    "counts": {"type": "object"}
  },
  "additionalProperties": true
}
