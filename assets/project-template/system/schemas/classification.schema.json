{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate classification",
  "type": "object",
  "required": ["campaign_id", "candidate_id", "classification", "reason", "evidence_urls", "checked_at", "completion_status"],
  "properties": {
    "campaign_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "classification": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "checked_at": {"type": "string"},
    "completion_status": {"type": "string", "enum": ["completed", "excluded", "failed"]}
  },
  "additionalProperties": false
}
