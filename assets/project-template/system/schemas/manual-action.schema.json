{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local manual follow-up action",
  "type": "object",
  "required": [
    "action_id",
    "campaign_id",
    "account_id",
    "approval_id",
    "copy_record_id",
    "publisher_brand",
    "route_type",
    "route_url",
    "subject",
    "message",
    "message_format",
    "status",
    "queued_at",
    "updated_at"
  ],
  "properties": {
    "action_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "account_id": {"type": "string"},
    "approval_id": {"type": "string"},
    "copy_record_id": {"type": "string"},
    "publisher_brand": {"type": "string", "minLength": 1},
    "route_type": {"type": "string"},
    "route_url": {"type": "string", "format": "uri"},
    "subject": {"type": "string"},
    "message": {"type": "string"},
    "message_format": {"type": "string", "const": "plain_text_paragraphs"},
    "status": {"type": "string", "enum": ["queued", "done", "held"]},
    "queued_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "completed_at": {"type": ["string", "null"]},
    "hold_reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "held"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"hold_reason": {"type": "string", "minLength": 1}},
        "required": ["hold_reason"]
      }
    }
  ],
  "additionalProperties": false
}
