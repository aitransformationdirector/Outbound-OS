{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewable outreach item",
  "type": "object",
  "required": ["campaign_id", "account_id", "publisher_name", "publisher_brand", "publisher_url", "route_type", "provider_status", "copy_record_id", "copy_branch", "copy_format", "subject", "body", "proposed_action", "workflow_status", "review_stage"],
  "properties": {
    "campaign_id": {"type": "string"},
    "account_id": {"type": "string"},
    "publisher_name": {"type": "string"},
    "publisher_brand": {"type": "string", "minLength": 1},
    "publisher_url": {"type": "string"},
    "parent_company": {"type": ["string", "null"]},
    "portfolio_domains": {"type": "array", "items": {"type": "string"}},
    "contact_name": {"type": ["string", "null"]},
    "contact_email": {"type": ["string", "null"]},
    "route_type": {"type": "string", "enum": ["direct_email", "role_email", "commercial_form", "profile", "commercial_phone", "none"]},
    "route_url": {"type": ["string", "null"]},
    "provider_status": {"type": "string"},
    "provider_evidence_url": {"type": ["string", "null"]},
    "evidence_urls": {"type": "array", "items": {"type": "string"}},
    "evidence_summary": {"type": "string"},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "copy_record_id": {"type": "string", "minLength": 1},
    "copy_branch": {"type": "string"},
    "copy_format": {"type": "string", "const": "plain_text_paragraphs"},
    "subject": {"type": "string"},
    "body": {"type": "string"},
    "proposed_action": {"type": "string", "enum": ["create_gmail_draft", "queue_manual_route", "none"]},
    "gmail_history_status": {"type": "string", "enum": ["clear", "suppressed", "reviewed_conflict", "not_applicable", "not_checked"]},
    "workflow_status": {"type": "string", "enum": ["actionable", "excluded", "held", "failed"]},
    "status_reason": {"type": ["string", "null"]},
    "review_stage": {"type": "string", "enum": ["smoke", "full"]}
  },
  "additionalProperties": false
}
