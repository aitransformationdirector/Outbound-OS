{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SSP outreach run request",
  "type": "object",
  "required": ["source_csv", "target_provider"],
  "properties": {
    "source_csv": {"type": "string", "minLength": 1},
    "target_provider": {"type": "string", "minLength": 1},
    "minimum_monthly_traffic": {"type": "integer", "minimum": 1},
    "target_verticals": {"type": "array", "items": {"type": "string"}},
    "target_geographies": {"type": "array", "items": {"type": "string"}},
    "user_note": {"type": "string"},
    "campaign_label": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
