{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-campaign confirmed suppression memory",
  "type": "object",
  "required": [
    "suppression_id",
    "campaign_id",
    "canonical_domain",
    "reason_type",
    "provenance",
    "recorded_at",
    "updated_at"
  ],
  "properties": {
    "suppression_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "canonical_domain": {"type": "string", "minLength": 3},
    "publisher_brand": {"type": ["string", "null"]},
    "reason_type": {
      "type": "string",
      "enum": [
        "prior_relationship",
        "unsuccessful_outreach",
        "opt_out",
        "colleague_owned"
      ]
    },
    "provider_scope": {"type": ["string", "null"]},
    "note": {"type": ["string", "null"]},
    "provenance": {"type": "string", "enum": ["dean_confirmed"]},
    "recorded_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
