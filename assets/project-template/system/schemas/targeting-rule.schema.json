{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["rule_id", "kind", "statement", "evidence_requirement", "unknown_handling", "source"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["must_match", "exclude", "prioritize"]},
    "statement": {"type": "string", "minLength": 1},
    "metric": {"type": ["string", "null"]},
    "operator": {"type": ["string", "null"]},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "evidence_requirement": {"type": "string", "minLength": 1},
    "unknown_handling": {"enum": ["needs_review", "not_applicable"]},
    "source": {"enum": ["user", "suggested"]}
  }
}
