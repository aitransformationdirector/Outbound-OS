{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material claim verification",
  "type": "object",
  "required": ["campaign_id", "account_id", "claim_id", "verdict", "reason", "checked_at"],
  "properties": {
    "campaign_id": {"type": "string"},
    "account_id": {"type": "string"},
    "claim_id": {"type": "string"},
    "verdict": {"type": "string", "enum": ["verified", "narrowed", "rejected", "unverified"]},
    "reason": {"type": "string"},
    "replacement_claim": {"type": ["string", "null"]},
    "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "checked_at": {"type": "string"}
  },
  "additionalProperties": false
}

